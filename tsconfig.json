{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@lionrockjs/central": ["../../../system/central/src/index.ts"],
      "@lionrockjs/router": ["../../../system/router/src/index.ts"],
      "@lionrockjs/mvc": ["../../../system/mvc/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "types"
  ]
}
